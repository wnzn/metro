FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS linux
WORKDIR /source

FROM linux AS windows
RUN apt-get -o APT::Update::Error-Mode=any update \
    && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64-posix cmake ninja-build nasm \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-pc-windows-gnu
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc-posix \
    CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc-posix \
    AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar
