# Metro example environment for compose.yaml.
# The README quickstart generates a minimal .env for you. Copy entries from here
# when you need them. .env is git-ignored; never commit real tokens.
# Empty values count as unset.

# --- Human auth (required: exactly one mode) ------------------------------
# Dev users, local only: JSON map of username -> token (16-512 printable bytes,
# distinct per user). The username is the user id that Space owners add.
# Single-quote it. Generate each token with: openssl rand -hex 32
# METRO_DEV_USERS='{"alice":"replace-with-token","bob":"replace-with-token"}'

# OIDC JWT access tokens: both values are required. The issuer must be https://
# and must equal the provider's discovery "issuer" exactly (trailing slash too).
# The user id is the token's "sub". Don't combine any METRO_OIDC_* setting with
# METRO_DEV_USERS. The database is pinned to the first mode and issuer it sees.
# METRO_OIDC_ISSUER=https://auth.example.com/
# METRO_OIDC_AUDIENCE=metro
# Claim shown as the user's display name; membership always uses "sub".
# METRO_OIDC_ACTOR_CLAIM=preferred_username
# METRO_OIDC_REQUIRED_TYP=at+jwt
# METRO_OIDC_LEEWAY_SECS=60

# --- Model (optional: agent replies need it, Demo doesn't) ------------------
# METRO_MODEL=your-model-id
# METRO_MODEL_BASE_URL=https://api.openai.com/v1
# METRO_MODEL_API_KEY=replace-with-your-key

# --- Optional runner (compose profile "runner") ------------------------------
# There is no server-wide runner token. A Space owner issues one per Space
# (POST /v1/spaces/{sid}/runner-token). Pass it on the command line, not here:
#   METRO_RUNNER_TOKEN="$(cat path/to/space.runner-token)" docker compose --profile runner up -d runner
# Host directory mounted at /workspace in the runner container.
# METRO_WORKSPACE_HOST=./examples/workspace
# Build-time UID/GID of the runner image user (must be able to read the workspace).
# METRO_RUNNER_UID=1000
# METRO_RUNNER_GID=1000
# Operator-defined JSON argv, run directly without a shell. Unset = no check.
# METRO_CHECK_ARGV='["./check.sh"]'
# Optional stdio MCP server, JSON argv. Unset = no MCP.
# METRO_MCP_ARGV='["/usr/local/bin/my-mcp-server","--stdio"]'
# Sandboxing is opt-in. Leave METRO_SANDBOX unset (none) here: the bundled runner container has no
# Docker access, so docker mode would fail closed. See docs/runner.md.
