<?xml version="1.0" encoding="utf-8"?>
<!--
  Metro Setup wizard (Windows Installer native dialogs), compiled by wixl.

  Install:      WelcomeDlg -> InstallDirDlg (folder + Browse..., local runner,
                Start menu) -> VerifyReadyDlg -> ProgressDlg -> ExitDialog
  Browse...:    BrowseDlg, Windows Installer's own folder browser
                (DirectoryCombo + DirectoryList + PathEdit, Up, New folder)
  Maintenance:  MaintenanceDlg (Repair / Remove) -> VerifyReadyDlg -> ...

  Conventions for wixl 0.106: Publish/Show/Custom conditions are attributes;
  the first Control of each Dialog is its first tab stop (build_msi.py rewrites
  Control_Next to the TAB_ORDER it declares, because wixl skips some control
  types when it chains tab stops).
  Properties used here are set by the product (build_msi.py):
  MetroSemver, MetroPreview, MetroDataDir, LRBOX, SCBOX, PREVSEMVER,
  OLDERFOUND, SAMEVERSIONFOUND, VCREDIST, WIXUI_INSTALLDIR.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI Id="MetroUI">
      <Property Id="DefaultUIFont" Value="MetroNormal" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

      <!-- Welcome ................................................... -->
      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="BrandIcon" Type="Icon" X="20" Y="12" Width="28" Height="28" FixedSize="yes" IconSize="32" Text="MetroSetupMark" />
        <Control Id="BrandName" Type="Text" X="52" Y="13" Width="55" Height="24" NoPrefix="yes" Text="{\MetroBrand}metro" />
        <Control Id="Title" Type="Text" X="20" Y="42" Width="330" Height="21" NoPrefix="yes" Text="{\MetroBigger}Welcome to Metro Setup" />
        <Control Id="Description" Type="Text" X="20" Y="67" Width="330" Height="40" NoPrefix="yes" Text="Setup installs Metro [MetroSemver] for you only. No administrator rights are needed. Next, you choose the folder and what Setup sets up." HideCondition="OLDERFOUND OR SAMEVERSIONFOUND" ShowCondition="NOT (OLDERFOUND OR SAMEVERSIONFOUND)" />
        <Control Id="UpgradeDescription" Type="Text" X="20" Y="67" Width="330" Height="40" NoPrefix="yes" Text="Setup updates Metro [PREVSEMVER] to Metro [MetroSemver]. Close Metro before you continue." ShowCondition="OLDERFOUND OR SAMEVERSIONFOUND" HideCondition="NOT (OLDERFOUND OR SAMEVERSIONFOUND)" />
        <Control Id="DataNote" Type="Text" X="20" Y="113" Width="330" Height="40" NoPrefix="yes" Text="Your Metro data in [MetroDataDir] is never changed or removed by Setup, including when you update or uninstall Metro." />
        <Control Id="PreviewNote" Type="Text" X="20" Y="160" Width="330" Height="48" NoPrefix="yes" Text="{\MetroWarning}This Metro build isn't code-signed, so Windows may warn about an unknown publisher. Before you install it, check the file against its SHA-256 checksum (SHA256SUMS)." Hidden="yes" ShowCondition="MetroPreview = &quot;1&quot;" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Destination folder and options ............................ -->
      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Folder" Type="PathEdit" X="20" Y="70" Width="268" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="294" Y="70" Width="61" Height="18" Text="B&amp;rowse...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="LocalRunner" Type="CheckBox" X="20" Y="118" Width="335" Height="14" Property="LRBOX" CheckBoxValue="1" Text="Set up my personal &amp;local runner on this device (recommended)" />
        <Control Id="StartMenu" Type="CheckBox" X="20" Y="162" Width="335" Height="14" Property="SCBOX" CheckBoxValue="1" Text="Add Metro to the &amp;Start menu" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Destination folder and options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose where Metro [MetroSemver] goes and what Setup sets up." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="57" Width="268" Height="12" NoPrefix="yes" Text="Install Metro in this folder:" />
        <Control Id="FolderHint" Type="Text" X="20" Y="91" Width="335" Height="22" NoPrefix="yes" Text="Pick a new or empty folder that you can write to. Uninstalling removes only the files Setup installed there." />
        <Control Id="LocalRunnerHint" Type="Text" X="33" Y="133" Width="322" Height="26" NoPrefix="yes" Text="After you sign in, Metro sets up a runner on this device that only you own. It isn't attached to any Space until you choose it under Manage Space." />
        <Control Id="StartMenuHint" Type="Text" X="33" Y="177" Width="322" Height="12" NoPrefix="yes" Text="Without it, start Metro.exe from the folder above." />
        <Control Id="VcWarning" Type="Text" X="20" Y="194" Width="335" Height="36" NoPrefix="yes" Text="{\MetroWarning}Microsoft Visual C++ Redistributable (x64) was not found. Metro needs it to start. Install it from https://aka.ms/vs/17/release/vc_redist.x64.exe (Setup can continue without it)." Hidden="yes" ShowCondition="VCREDIST &lt;&gt; &quot;#1&quot;" HideCondition="VCREDIST = &quot;#1&quot;" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Browse (Windows Installer's folder browser) ................ -->
      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18" Property="_BrowseProperty" Indirect="yes" />
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="215" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="290" Y="55" Width="27" Height="17" ToolTip="Up one level" Text="&amp;Up">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="320" Y="55" Width="35" Height="17" ToolTip="Create a new folder" Text="Ne&amp;w">
          <Publish Event="DirectoryListNew" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="330" Height="98" Property="_BrowseProperty" Sunken="yes" Indirect="yes" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Change destination folder" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Browse to the folder for Metro, or type its full path below." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" Text="&amp;Look in:" />
        <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10" Text="&amp;Folder name:" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Ready to install / repair / remove ........................ -->
      <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="[ProductName] Setup" TrackDiskSpace="yes">
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Install" Hidden="yes" ShowCondition="NOT Installed">
          <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="1" Condition="OutOfDiskSpace = 1" />
          <Publish Event="EndDialog" Value="Return" Order="2" Condition="OutOfDiskSpace &lt;&gt; 1" />
        </Control>
        <Control Id="Repair" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Repair" Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Repair&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="Re&amp;move" Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Remove&quot;">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="MaintenanceDlg" Order="2" Condition="Installed" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="InstallTitle" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Ready to install Metro" Hidden="yes" ShowCondition="NOT Installed" />
        <Control Id="RepairTitle" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Ready to repair Metro" Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Repair&quot;" />
        <Control Id="RemoveTitle" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Ready to remove Metro" Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Remove&quot;" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="InstallText" Type="Text" X="25" Y="55" Width="330" Height="12" NoPrefix="yes" Text="Metro [MetroSemver] will be installed in:" Hidden="yes" ShowCondition="NOT Installed" />
        <Control Id="InstallPath" Type="Text" X="35" Y="69" Width="320" Height="24" NoPrefix="yes" Text="[INSTALLDIR]" Hidden="yes" ShowCondition="NOT Installed" />
        <Control Id="RunnerOn" Type="Text" X="25" Y="99" Width="330" Height="12" NoPrefix="yes" Text="Personal local runner: set up after you sign in" Hidden="yes" ShowCondition="NOT Installed AND LRBOX" />
        <Control Id="RunnerOff" Type="Text" X="25" Y="99" Width="330" Height="12" NoPrefix="yes" Text="Personal local runner: off" Hidden="yes" ShowCondition="NOT Installed AND NOT LRBOX" />
        <Control Id="ShortcutOn" Type="Text" X="25" Y="113" Width="330" Height="12" NoPrefix="yes" Text="Start menu shortcut: yes" Hidden="yes" ShowCondition="NOT Installed AND SCBOX" />
        <Control Id="ShortcutOff" Type="Text" X="25" Y="113" Width="330" Height="12" NoPrefix="yes" Text="Start menu shortcut: no" Hidden="yes" ShowCondition="NOT Installed AND NOT SCBOX" />
        <Control Id="UpgradeText" Type="Text" X="25" Y="133" Width="330" Height="24" NoPrefix="yes" Text="Metro [PREVSEMVER] will be replaced. Close Metro before you click Install." Hidden="yes" ShowCondition="NOT Installed AND (OLDERFOUND OR SAMEVERSIONFOUND)" />
        <Control Id="RepairText" Type="Text" X="25" Y="55" Width="330" Height="36" NoPrefix="yes" Text="Setup puts back missing or damaged Metro files in [INSTALLDIR] and keeps your choices. Close Metro first." Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Repair&quot;" />
        <Control Id="RemoveText" Type="Text" X="25" Y="55" Width="330" Height="48" NoPrefix="yes" Text="Setup removes the files it installed in [INSTALLDIR], its Start menu shortcut and its uninstall entry. Files you added there are kept. Close Metro first." Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Remove&quot;" />
        <Control Id="DataNote" Type="Text" X="25" Y="165" Width="330" Height="36" NoPrefix="yes" Text="Your Metro data in [MetroDataDir] is kept." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Maintenance (Metro is installed from this package) ......... -->
      <Dialog Id="MaintenanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="RepairButton" Type="PushButton" X="25" Y="85" Width="80" Height="17" Default="yes" Text="&amp;Repair">
          <Publish Property="MetroMode" Value="Repair" Order="1" />
          <Publish Event="ReinstallMode" Value="ecmus" Order="2" />
          <Publish Event="Reinstall" Value="ALL" Order="3" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4" />
        </Control>
        <Control Id="RemoveButton" Type="PushButton" X="25" Y="130" Width="80" Height="17" Text="Re&amp;move">
          <Publish Property="MetroMode" Value="Remove" Order="1" />
          <Publish Event="Remove" Value="ALL" Order="2" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="{\MetroBigger}Repair or remove Metro" />
        <Control Id="Installed" Type="Text" X="20" Y="55" Width="330" Height="24" NoPrefix="yes" Text="Metro [MetroSemver] is installed in [INSTALLDIR]" />
        <Control Id="RepairText" Type="Text" X="115" Y="85" Width="240" Height="36" NoPrefix="yes" Text="Put back missing or damaged Metro files. Your choices and data are kept." />
        <Control Id="RemoveText" Type="Text" X="115" Y="130" Width="240" Height="36" NoPrefix="yes" Text="Remove Metro from this device. Your Metro data and files you added are kept." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Progress .................................................. -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Working on Metro" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Text" Type="Text" X="25" Y="65" Width="330" Height="24" NoPrefix="yes" Text="Please wait while Setup changes Metro. This takes a minute or so." />
        <Control Id="StatusLabel" Type="Text" X="25" Y="100" Width="50" Height="10" Text="Status:" />
        <Control Id="ActionText" Type="Text" X="75" Y="100" Width="280" Height="10" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="25" Y="115" Width="330" Height="10" ProgressBlocks="yes" Text="Progress done">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- End states ................................................ -->
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
        <Control Id="BrandIcon" Type="Icon" X="20" Y="12" Width="28" Height="28" FixedSize="yes" IconSize="32" Text="MetroSetupMark" />
        <Control Id="BrandName" Type="Text" X="52" Y="13" Width="55" Height="24" NoPrefix="yes" Text="{\MetroBrand}metro" />
        <Control Id="Title" Type="Text" X="20" Y="42" Width="330" Height="21" NoPrefix="yes" Text="{\MetroBigger}Metro Setup finished" />
        <Control Id="InstalledText" Type="Text" X="20" Y="67" Width="330" Height="36" NoPrefix="yes" Text="Metro [MetroSemver] is installed in [INSTALLDIR]" Hidden="yes" ShowCondition="NOT Installed OR MetroMode = &quot;Repair&quot;" />
        <Control Id="StartMenuText" Type="Text" X="20" Y="107" Width="330" Height="24" NoPrefix="yes" Text="Start it from the Start menu: Metro." Hidden="yes" ShowCondition="(NOT Installed OR MetroMode = &quot;Repair&quot;) AND SCBOX" />
        <Control Id="NoStartMenuText" Type="Text" X="20" Y="107" Width="330" Height="24" NoPrefix="yes" Text="Start it with Metro.exe in that folder." Hidden="yes" ShowCondition="(NOT Installed OR MetroMode = &quot;Repair&quot;) AND NOT SCBOX" />
        <Control Id="RemovedText" Type="Text" X="20" Y="67" Width="330" Height="36" NoPrefix="yes" Text="Metro was removed. Your Metro data in [MetroDataDir] was kept." Hidden="yes" ShowCondition="Installed AND MetroMode = &quot;Remove&quot;" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="{\MetroBigger}Metro Setup was cancelled" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="40" NoPrefix="yes" Text="Nothing was changed: anything Setup had started was rolled back. Run Setup again whenever you like." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="{\MetroBigger}Metro Setup ended early" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="330" Height="60" NoPrefix="yes" Text="An error stopped Setup and its changes were rolled back. Your Metro data was not touched. For details, run Setup again from a terminal with: msiexec /i &lt;this file&gt; /l*v setup.log" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <!-- Dialogs Windows Installer opens by itself ................. -->
      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="[ProductName] Setup" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="12" Width="230" Height="60" NoPrefix="yes" TabSkip="no" Text="Information text" />
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="No">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Retry">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="Yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
      </Dialog>

      <Dialog Id="FilesInUse" Width="370" Height="270" Title="[ProductName] Setup" KeepModeless="yes">
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="235" Y="243" Width="56" Height="17" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="166" Y="243" Width="56" Height="17" Text="E&amp;xit">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="List" Type="ListBox" X="20" Y="87" Width="330" Height="130" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Files in use" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Text" Type="Text" X="20" Y="55" Width="330" Height="30" NoPrefix="yes" Text="These applications use files that Setup needs to change. Close them (including Metro) and click Retry." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <Dialog Id="OutOfDiskDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="OK" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="VolumeList" Type="VolumeCostList" X="20" Y="100" Width="330" Height="120" Sunken="yes" Fixed="yes" Remote="yes" Text="{120}{70}{70}{70}{70}" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\MetroTitle}Not enough disk space" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Text" Type="Text" X="20" Y="55" Width="330" Height="40" NoPrefix="yes" Text="The highlighted drive doesn't have enough free space for Metro. Free up space, or go back and pick a folder on another drive." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="WelcomeDlg" Sequence="1297" Condition="NOT Installed" />
        <Show Dialog="MaintenanceDlg" Sequence="1298" Condition="Installed AND NOT RESUME AND NOT Preselected" />
        <Show Dialog="ProgressDlg" Sequence="1299" />
      </InstallUISequence>
    </UI>
  </Fragment>
</Wix>
