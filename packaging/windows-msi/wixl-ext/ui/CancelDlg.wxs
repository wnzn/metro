<?xml version="1.0" encoding="utf-8"?>
<!-- Metro's own cancel confirmation (see Common.wxs for why it lives here). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI Id="MetroCancel">
      <Dialog Id="CancelDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="No" Type="PushButton" X="132" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Yes" Type="PushButton" X="72" Y="57" Width="56" Height="17" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="30" NoPrefix="yes" Text="Cancel Metro Setup? Anything Setup has already changed is rolled back." />
      </Dialog>
    </UI>
  </Fragment>
</Wix>
