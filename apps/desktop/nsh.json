{
  "name": "Metro",
  "id": "dev.metro.desktop",
  "version": "0.4.0",
  "build": 2,
  "nsh": ">=0.6, <0.7",
  "theme": "theme/theme.json",
  "window": {
    "title": "Metro",
    "defaultSize": { "width": 1100, "height": 720 },
    "minSize": { "width": 720, "height": 480 }
  },
  "capabilities": {
    "network": { "hosts": ["*"] },
    "fs": {
      "read": ["${dataDir}", "${homeDir}/Downloads"],
      "write": ["${dataDir}", "${homeDir}/Downloads"]
    },
    "process": { "env": ["METRO_DESKTOP_BRIDGE_URL", "METRO_DESKTOP_BRIDGE_TOKEN", "METRO_PROXY_ROUTE", "METRO_PROXY_DIRECT_FOR"] },
    "openUrl": { "schemes": ["https", "http"] },
    "picker": true,
    "clipboard": true,
    "statusBar": true,
    "homeDir": true,
    "audio": true,
    "application": true
  }
}
