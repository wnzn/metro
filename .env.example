# Metro example environment for compose.yaml.
# Contributor stack from source: docs/development.md generates a minimal .env.
# Operators using the published image: see docs/deploy.md. Copy entries from here
# when you need them. .env is git-ignored; never commit real tokens.
# Empty values count as unset.

# --- Human auth (required: exactly one mode) ------------------------------
# Dev users, local only: JSON map of username -> token (16-512 printable bytes,
# distinct per user). The username is the user id that Space owners add.
# Single-quote it. Generate each token with: openssl rand -hex 32
# METRO_DEV_USERS='{"alice":"replace-with-token","bob":"replace-with-token"}'

# OIDC JWT access tokens: both values are required. The issuer must be https://
# and must equal the provider's discovery "issuer" exactly (trailing slash too).
# The user id is the token's "sub". Don't combine any METRO_OIDC_* setting with
# METRO_DEV_USERS. The database is pinned to the first mode and issuer it sees.
# METRO_OIDC_ISSUER=https://auth.example.com/
# METRO_OIDC_AUDIENCE=metro
# Claim shown as the user's display name; membership always uses "sub".
# METRO_OIDC_ACTOR_CLAIM=preferred_username
# METRO_OIDC_REQUIRED_TYP=at+jwt
# METRO_OIDC_LEEWAY_SECS=60

# --- Fallback model (optional) -----------------------------------------------
# Used only for people who have no default personal connection. Demo never
# calls a model.
# METRO_MODEL=your-model-id
# METRO_MODEL_BASE_URL=https://api.openai.com/v1
# METRO_MODEL_API_KEY=replace-with-your-key

# --- Personal model connections (optional) ---------------------------------
# People choose their own model in Settings -> Model providers; METRO_MODEL above
# is only the fallback for people with no default connection. Device connections
# (device-*) need none of this: the vendor credential stays on the user's machine.
# To let people save API keys on the server, set exactly one master key source:
# base64 of exactly 32 random bytes, e.g. from: openssl rand -base64 32
# METRO_PROVIDER_MASTER_KEY=replace-with-base64-32-bytes
# Or keep it in a file instead (preferred with Compose): see
# compose.provider-key-file.yaml and METRO_PROVIDER_MASTER_KEY_HOST_FILE. Inside the
# container the server reads METRO_PROVIDER_KEY_FILE. Keep the key out of the
# database volume and back it up separately; losing it means everyone re-enters
# their keys.
# Exact custom base URLs (self-hosted OpenAI-compatible endpoints) people may use:
# METRO_PROVIDER_ALLOWED_BASE_URLS='["https://llm.internal.example/v1"]'

# --- Scheduled prompts (optional) -------------------------------------------
# Longest scheduler sleep in seconds (default 30, clamped 1..300). It wakes
# earlier for the next due task, so this rarely needs changing. See docs/schedules.md.
# METRO_SCHEDULE_TICK_SECS=30

# --- Documents & media library (optional) ------------------------------------
# Limits for explicitly uploaded files (personal or Space). Defaults shown.
# Out-of-range values stop the server from starting. See docs/library.md.
# compose.yaml passes these through; unset or blank means the default.
# Per file, 1..8388608 (8 MiB max):
# METRO_LIBRARY_MAX_FILE_BYTES=8388608
# Everything one person uploaded, personal + Spaces (256 MiB):
# METRO_LIBRARY_USER_QUOTA_BYTES=268435456
# Per Space (1 GiB):
# METRO_LIBRARY_SPACE_QUOTA_BYTES=1073741824
# METRO_LIBRARY_MAX_FILES_PER_USER=2000
# Concurrent buffered uploads, 1..64:
# METRO_LIBRARY_MAX_CONCURRENT_UPLOADS=4
# Uploads one person may have in progress at once (1..the value above):
# METRO_LIBRARY_MAX_UPLOADS_PER_USER=2
# Total time for one upload body, in seconds (1..600):
# METRO_LIBRARY_UPLOAD_TIMEOUT_SECS=120
# Longest gap with no bytes arriving, in seconds (1..the timeout):
# METRO_LIBRARY_UPLOAD_IDLE_TIMEOUT_SECS=20

# --- Optional media embedding service (compose.media.yaml) ------------------
# Only read with: docker compose -f compose.yaml -f compose.media.yaml ...
# Builds from source; see docs/development.md#media-embedding-service-composemediayaml.
# Paths must be absolute;
# the key file holds a separate key (never the provider master key).
# METRO_EG2_MODEL_SOURCE=/absolute/path/to/embeddinggemma-2   # import step only
# METRO_EG2_API_KEY_HOST_FILE=/absolute/path/to/eg2.key       # mode 600, owned by uid 10001
# Container memory ceiling (a cap, not a measured requirement of the real weights):
# METRO_EG2_MEMORY_LIMIT=8g

# --- Organization (optional) ------------------------------------------------
# One organization per server. JSON array of stable user ids (the dev username,
# or the OIDC "sub"), never display names. Org admins create and manage
# organization runners and, with local accounts, manage accounts in the admin
# panel at /admin (never a managed mu: id). Unset = no org admins.
# METRO_ORG_ADMINS='["alice"]'

# --- Optional dedicated runner (compose profile "runner") --------------------
# There is no server-wide runner token. A Space owner issues one per Space
# (POST /v1/spaces/{sid}/runner-token). It serves that Space only. Pass it on
# the command line, not here:
#   METRO_RUNNER_TOKEN="$(cat path/to/space.runner-token)" docker compose --profile runner up -d runner
# Host directory mounted at /workspace in the runner container.
# METRO_WORKSPACE_HOST=./examples/workspace
# Build-time UID/GID of the runner image user (must be able to read the workspace).
# METRO_RUNNER_UID=1000
# METRO_RUNNER_GID=1000
# Operator-defined JSON argv, run directly without a shell. Unset = no check.
# METRO_CHECK_ARGV='["./check.sh"]'
# Optional stdio MCP server, JSON argv. Unset = no MCP.
# METRO_MCP_ARGV='["/usr/local/bin/my-mcp-server","--stdio"]'
# Sandboxing is opt-in. Leave METRO_SANDBOX unset (none) here: the bundled runner container has no
# Docker access, so docker mode would fail closed. See docs/runner.md.

# --- Optional registered runner (compose profile "reusable-runner") ----------
# A personal or organization runner (POST /v1/runners) that serves every Space
# it's attached to, each in /workspace/spaces/<sid>/. Its credential starts with
# metro_rt_v2_ and is separate from the dedicated token above. Pass it at start:
#   METRO_REGISTERED_RUNNER_TOKEN="$(sed -n 's/^METRO_RUNNER_TOKEN=//p' path/to/runner.env)" \
#     docker compose --profile reusable-runner up -d registered-runner
# It offers list and read only (no check or MCP without a Docker sandbox).
# Storage: the named volume metro-workspaces (default), or an absolute host path
# that already exists and is writable by METRO_RUNNER_UID:METRO_RUNNER_GID.
# METRO_REGISTERED_WORKSPACES=metro-workspaces
